{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Discovery and Capture V1 contracts",
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "roots"
      ],
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "allow_private_network": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1
        },
        "sample_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "schema_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": 1
        }
      }
    },
    "artefact": {
      "type": "object",
      "required": [
        "id",
        "role",
        "version_id",
        "sha256",
        "size",
        "media_type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "original",
            "derived",
            "snapshot"
          ]
        },
        "version_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^(originals|derived|snapshots)/[a-f0-9]{64}\\.[A-Za-z0-9]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artefact_id",
              "version_id",
              "sha256"
            ]
          }
        }
      }
    },
    "source_pack": {
      "type": "object",
      "required": [
        "id",
        "schema_version",
        "created_at",
        "artefacts",
        "provenance",
        "verification",
        "exclusions",
        "organisation",
        "sources",
        "gaps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "created_at": {
          "type": "string"
        },
        "artefacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artefact"
          }
        },
        "provenance": {
          "type": "array"
        },
        "verification": {
          "type": "array"
        },
        "exclusions": {
          "type": "array"
        },
        "sources": {
          "type": "array"
        },
        "gaps": {
          "type": "array"
        },
        "organisation": {
          "type": "object"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/scope"
    },
    {
      "$ref": "#/$defs/budget"
    },
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/source_pack"
    }
  ]
}
